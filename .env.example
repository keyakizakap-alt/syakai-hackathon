# 未設定でもデモモードで動作します（プリセット例のみ解析可能）。
# 実際のLLM解析を行うには Anthropic の API キーを設定してください。
ANTHROPIC_API_KEY=sk-ant-...

# 各処理で使うモデルを個別に上書きできる（省略時は下記の既定値を使用）。
# 対応表・料金の考え方は README の「モデルの切り替え」を参照。
# NUANCE_MODEL_PANEL=claude-sonnet-5    # 文化規範判定（既定・基本モデル）
# NUANCE_MODEL_GATE=claude-haiku-4-5    # 逆翻訳の品質採点（既定・最安）
# NUANCE_MODEL_FILTER=claude-haiku-4-5  # 受信フィルタのタグ写像（既定・最安）
