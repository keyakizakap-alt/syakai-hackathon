# 未設定でもデモモードで動作します（プリセット例のみ解析可能）。
# 実際のLLM解析を行うには Anthropic の API キーを設定してください。
# panel（文化規範判定）は常にこちらを使う。
ANTHROPIC_API_KEY=sk-ant-...

# gate（逆翻訳の品質採点）・filter（受信フィルタのタグ写像）は既定で OpenRouter を使う。
# OpenRouter は Gemini・Llama・DeepSeek 等を1つのAPIキーで呼び出せるプロキシ。
# https://openrouter.ai/keys で取得。未設定だとデモモードにフォールバックする。
# OPENROUTER_API_KEY=sk-or-...

# 各処理で使うプロバイダ・モデルを個別に上書きできる（省略時は下記の既定値を使用）。
# 対応表・料金の考え方は README の「モデルの切り替え」を参照。
# NUANCE_MODEL_PANEL=claude-sonnet-5          # 文化規範判定（既定・基本モデル）
# NUANCE_MODEL_GATE=google/gemini-2.5-flash   # 逆翻訳の品質採点（既定・OpenRouter経由）
# NUANCE_MODEL_FILTER=google/gemini-2.5-flash # 受信フィルタのタグ写像（既定・OpenRouter経由）

# プロバイダ自体を切り替えたい場合（例：gate/filterをOpenRouterではなくClaudeに戻す）
# NUANCE_PROVIDER_GATE=anthropic
# NUANCE_PROVIDER_FILTER=anthropic
