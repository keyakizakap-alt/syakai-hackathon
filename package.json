{
  "name": "nuance-customs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "eval": "tsx eval/run.ts",
    "eval:live": "tsx eval/run.ts --live",
    "eval:report": "tsx eval/run.ts --out docs/BENCHMARK.md",
    "verify": "npm run typecheck && npm run test && npm run eval"
  },
  "dependencies": {
    "next": "^16.3.2",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
